VITE_PORTFOLIO_API_URL=/api/portfolio
VITE_APPS_API_URL=http://localhost:8002/api/allprojects
VITE_APPS_FRONTEND_URL=http://localhost:1576
# Public SSO frontend (login/signup/account pages)
VITE_SSO_FRONTEND_URL=http://localhost:5173
